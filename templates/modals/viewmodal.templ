<div id="view-modal" class="modal modal-open">
    <div class="modal-box max-w-4xl">
        <div class="flex items-center justify-between gap-3 mb-2">
            <h3 class="font-bold text-lg">View File: {{.FileName}}</h3>
            <span class="badge badge-outline" data-hl-lang></span>
        </div>
        <div class="py-4">
            <div class="bg-base-300 p-4 rounded-lg overflow-auto max-h-96">
                <pre class="hl text-sm whitespace-pre-wrap" data-filename="{{.FileName}}">{{.FileContent}}</pre>
            </div>
        </div>
        <div class="modal-action">
            <button class="btn btn-primary" onclick="window.location.href='/tftp/download?file={{.FileName}}'">Download</button>
            <button type="button" class="btn" hx-get="/close_modal" hx-target="#modal-content">Close</button>
        </div>
    </div>
</div>