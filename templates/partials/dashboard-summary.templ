<section class="stats" aria-label="Lease summary">
    <div class="stat">
        <div class="stat-title">Active</div>
        <div class="stat-value">{{.Active}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">Expired</div>
        <div class="stat-value">{{.Expired}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">Reserved</div>
        <div class="stat-value">{{.Reserved}}</div>
    </div>
</section>
<section class="stats" aria-label="DHCP pools">
    {{range .Pools}}
    <div class="stat" data-status="{{.Status}}">
        <div class="stat-title">{{.Server}}</div>
        <div class="stat-value">{{.Free}}</div>
        <div class="stat-desc">{{.Used}} used / {{.Total}} total</div>
        <span class="st {{dhcpStateClass .Status}}">{{dhcpStateLabel .Status}}</span>
    </div>
    {{else}}
    <div class="stat">
        <div class="stat-title">Pools</div>
        <div class="stat-value">0</div>
        <div class="stat-desc">No DHCP servers</div>
    </div>
    {{end}}
</section>
