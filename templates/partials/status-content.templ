<div class="flex justify-between items-center mb-4">
    <div>
        <h2 class="font-bold">{{.Title}}</h2>
        <span class="text-sm mu">Last Updated: {{.LastUpdated}}</span>
    </div>
    <span class="st {{if eq .OverallStatus "healthy"}}ok{{else if eq .OverallStatus "partial"}}wa{{else}}er{{end}}">
        {{if eq .OverallStatus "healthy"}}System Healthy{{else if eq .OverallStatus "partial"}}Partial Service{{else}}System Down{{end}}
    </span>
</div>

<div class="tile-row">
    <article class="sv {{if eq .HTTPServer.Status "running"}}on{{end}}">
        <div class="fire {{if ne .HTTPServer.Status "running"}}off{{end}}"><img src="/public/http/img/flame.svg" alt=""></div>
        <div>
            <small>{{.HTTPServer.Name}}</small>
            <b>{{.HTTPServer.Status}}</b>
            <small>{{.HTTPServer.Details}}</small>
            <small>{{.HTTPServer.Description}}</small>
        </div>
    </article>
    <article class="sv {{if eq .TFTPServer.Status "running"}}on{{end}}">
        <div class="fire {{if ne .TFTPServer.Status "running"}}off{{end}}"><img src="/public/http/img/flame.svg" alt=""></div>
        <div>
            <small>{{.TFTPServer.Name}}</small>
            <b>{{.TFTPServer.Status}}</b>
            <small>{{.TFTPServer.Details}}</small>
            <small>{{.TFTPServer.Description}}</small>
        </div>
    </article>
</div>

<div class="mt">
    <h2 class="font-bold mb-2">DHCP Servers</h2>
    {{if .DHCPServers}}
    <div class="tile-row">
        {{range .DHCPServers}}
        <article class="sv {{if eq .Status "running"}}on{{end}}">
            <div class="fire {{if ne .Status "running"}}off{{end}}"><img src="/public/http/img/flame.svg" alt=""></div>
            <div>
                <small>Server {{.IP}}</small>
                <b>{{.Status}}</b>
                <p>Active Leases: {{.LeaseCount}}</p>
                <small>{{.Description}}</small>
                <small>Server ID: {{.ID}}</small>
            </div>
        </article>
        {{end}}
    </div>
    {{else}}
    <div class="note">
        <p>No DHCP servers configured</p>
        <a href="/dhcp" class="b p sm mt">Configure DHCP Server</a>
    </div>
    {{end}}
</div>

<p class="text-xs mu mt">Status automatically refreshes every 10 seconds</p>
