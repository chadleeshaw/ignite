{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">System status</span><span class="only-console">status</span></h1>
        <p class="sub only-cozy">The same service picture shown on Overview.</p>
        <p class="sub only-console">same picture as overview</p>
    </div>
</header>
<div id="status-content" hx-get="/status/content" hx-trigger="every 10s" hx-swap="innerHTML">
    {{template "status-content.templ" .}}
</div>
{{ end }}
