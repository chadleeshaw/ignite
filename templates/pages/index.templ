{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">Overview</span><span class="only-console">overview</span></h1>
        <p class="sub only-cozy" id="overview-sub-cozy">{{.CozySubtitle}}</p>
        <p class="sub only-console" id="overview-sub-console">{{.ConsoleSubtitle}}</p>
    </div>
</header>

<div class="overview-board">
{{if .Status}}
<div id="status-services" class="overview-span" hx-get="/status/content" hx-trigger="every 10s">
    {{template "status-content.templ" .Status}}
</div>
{{else}}
<p class="note overview-full">Service status is unavailable</p>
{{end}}

<div id="overview-summary"
     class="overview-span"
     hx-get="{{summaryURL}}"
     hx-trigger="load, every 10s"
    >
    <section class="stats overview-full" aria-label="Services on this host">
        <div class="stat">
            <div class="stat-title">Leases</div>
            <div class="stat-value">{{.LeaseTotal}}</div>
            <div class="stat-desc">{{countPhrase .ServerCount "DHCP server" "DHCP servers"}}, {{.DHCPRunning}} running</div>
        </div>
        <div class="stat">
            <div class="stat-title">HTTP</div>
            <div class="stat-value">{{.HTTPStatus}}</div>
            <div class="stat-desc">Web interface</div>
        </div>
        <div class="stat">
            <div class="stat-title">TFTP</div>
            <div class="stat-value">{{.TFTPStatus}}</div>
            <div class="stat-desc">Boot file server</div>
        </div>
    </section>
</div>
</div>
{{ end }}
