{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">Overview</span><span class="only-console">overview</span></h1>
        <p class="sub only-cozy">{{.CozySubtitle}}</p>
        <p class="sub only-console">{{.ConsoleSubtitle}}</p>
    </div>
</header>

{{if .Status}}
<div id="status-services" hx-get="/status/content" hx-trigger="every 10s" hx-swap="innerHTML">
    {{template "status-content.templ" .Status}}
</div>
{{else}}
<p class="note">Service status is unavailable</p>
{{end}}

<div id="overview-summary"
     class="mt"
     hx-get="{{summaryURL}}"
     hx-trigger="load, every 10s"
     hx-swap="innerHTML">
    <section class="stats" aria-label="Services on this host">
        <div class="stat">
            <div class="stat-title">Leases</div>
            <div class="stat-value">{{.LeaseTotal}}</div>
            <div class="stat-desc">{{.ServerCount}} DHCP servers, {{.DHCPRunning}} running</div>
        </div>
        <div class="stat">
            <div class="stat-title">HTTP</div>
            <div class="stat-value">{{.HTTPStatus}}</div>
            <div class="stat-desc">Web interface</div>
        </div>
        <div class="stat">
            <div class="stat-title">TFTP</div>
            <div class="stat-value">{{.TFTPStatus}}</div>
            <div class="stat-desc">Boot file server</div>
        </div>
    </section>
</div>
{{ end }}
