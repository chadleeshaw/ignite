{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">Overview</span><span class="only-console">overview</span></h1>
        <p class="sub only-cozy" id="overview-sub-cozy">{{.CozySubtitle}}</p>
        <p class="sub only-console" id="overview-sub-console">{{.ConsoleSubtitle}}</p>
    </div>
    <div class="actions">
        <a class="b" href="/dhcp">New DHCP server</a>
        <a class="b p" href="/osimages">Download OS image</a>
    </div>
</header>

<div class="overview-board">
{{if .Status}}
<div id="status-services" class="overview-span" hx-get="/status/content" hx-trigger="every 10s">
    {{template "status-content.templ" .Status}}
</div>
{{else}}
<p class="note overview-full">Service status is unavailable</p>
{{end}}

<div id="overview-summary"
     class="overview-span"
     hx-get="{{summaryURL}}"
     hx-trigger="load, every 10s"
    >
    <section class="stats strip" aria-label="Lease and pool summary">
        <div class="stat"><div class="stat-title">Active leases</div><div class="stat-value">{{.LeaseTotal}}</div></div>
        <div class="stat"><div class="stat-title">Reserved</div><div class="stat-value">—</div></div>
        <div class="stat"><div class="stat-title">Expired</div><div class="stat-value">—</div></div>
        <div class="stat"><div class="stat-title">In flight</div><div class="stat-value warn">—</div></div>
        <div class="stat"><div class="stat-title">Failed</div><div class="stat-value bad"><a href="/dhcp">—</a></div></div>
        <div class="stat"><div class="stat-title">Free addresses</div><div class="stat-value">—</div></div>
    </section>
</div>
</div>
{{ end }}
