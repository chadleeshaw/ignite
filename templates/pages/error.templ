{{ define "content" }}
<main class="container mx-auto px-4 py-16 text-center">
    <p class="text-sm">{{.StatusCode}}</p>
    <h1 class="text-3xl font-bold mt-2">{{.Heading}}</h1>
    <p class="mt-4">{{.Message}}</p>
    <a class="btn btn-primary mt-8" href="/">Back to overview</a>
</main>
{{ end }}
