{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">OS images</span><span class="only-console">osimages</span></h1>
        <p class="sub only-cozy">Kernels and initrds for network installs</p>
        <p class="sub only-console">{{countPhrase (len .OSImages) "image" "images"}} · {{countPhrase .DownloadCount "download" "downloads"}}</p>
    </div>
    <div class="actions">
        <button class="b" type="button" hx-post="/ipxe/update" hx-swap="none">Regenerate iPXE config</button>
        <button class="b p" type="button" onclick="document.getElementById('os').focus()">Download OS image</button>
    </div>
</header>

<div class="os-top">
    {{if .Downloads}}
    {{with index .Downloads 0}}
    <article class="sv on">
        <div class="fire"><img src="/public/http/img/flame-nav.png" srcset="/public/http/img/flame-nav.png 1x, /public/http/img/flame-nav@2x.png 2x" width="19" height="24" alt=""></div>
        <div>
            <small>Downloading · {{.Progress}}%</small>
            <b>{{.OS}} {{.Version}}</b>
        </div>
        <span class="st wa" style="margin-left:auto">Active</span>
    </article>
    {{end}}
    {{else}}
    <article class="sv">
        <div class="fire off"><img src="/public/http/img/flame-nav.png" srcset="/public/http/img/flame-nav.png 1x, /public/http/img/flame-nav@2x.png 2x" width="19" height="24" alt=""></div>
        <div>
            <small>Downloads</small>
            <b>Idle</b>
        </div>
    </article>
    {{end}}
    <article class="sv">
        <div>
            <small>iPXE config</small>
            <b>Regenerate after image changes</b>
        </div>
        <span class="st ok" style="margin-left:auto">OK</span>
    </article>
    <section class="stats strip" aria-label="Image totals">
        <div class="stat"><div class="stat-title">Images</div><div class="stat-value">{{len .OSImages}}</div></div>
        <div class="stat"><div class="stat-title">Downloading</div><div class="stat-value">{{.DownloadCount}}</div></div>
        <div class="stat"><div class="stat-title">Kernels</div><div class="stat-value">{{formatBytes .KernelBytes}}</div></div>
        <div class="stat"><div class="stat-title">Initrds</div><div class="stat-value">{{formatBytes .InitrdBytes}}</div></div>
        <div class="stat"><div class="stat-title">Arch</div><div class="stat-value">{{.ArchLabel}}</div></div>
    </section>
</div>

<div id="osimage-downloads" class="main">
    <section class="panel">
        <div class="ph">
            <h3>Images</h3>
            <span class="mu">{{countPhrase (len .OSImages) "ready" "ready"}}{{if .DownloadCount}} · {{countPhrase .DownloadCount "download" "downloads"}}{{end}}</span>
        </div>
        <div id="active-downloads"{{if .Downloads}} hx-get="/osimages" hx-select="#osimage-downloads" hx-target="#osimage-downloads" hx-trigger="every 5s"{{end}}>
        {{if .Downloads}}
        <div class="sec">Active downloads</div>
        {{range .Downloads}}
        <div class="dl-row">
            <span><b>{{.OS}}</b> <span class="mono">{{.Version}}</span></span>
            <span class="prog"><i style="width: {{.Progress}}%"></i></span>
            <span class="mono">{{.Progress}}%</span>
            <span class="mu">started <time datetime="{{rfc3339 .StartedAt}}" data-time="time">{{utcLabel .StartedAt "15:04:05"}}</time></span>
            {{if or (eq .Status "downloading") (eq .Status "queued")}}
            <button class="b sm" hx-post="/osimages/cancel/{{.ID}}" hx-confirm="Cancel this download?">Cancel</button>
            {{else}}
            <span class="st in">{{.Status}}</span>
            {{end}}
        </div>
        {{end}}
        {{end}}
        </div>
        <div class="sec">Available images</div>
        {{if .OSImages}}
        <div class="cozy-view cards">
            {{range .OSImages}}
            <article class="cd" data-eol="{{if .EOL}}true{{else}}false{{end}}" style="cursor: default;">
                <div class="r">
                    <span><span class="ico {{.OS}}">{{initial .OS}}</span><b>{{.OS}} {{.Version}}</b></span>
                    {{if .EOL}}{{template "eol-badge" .}}{{else}}<span class="st ok">Ready</span>{{end}}
                </div>
                <div class="kv">
                    <span>Arch</span><span>{{.Architecture}}</span>
                    <span>Kernel</span><span>{{if .KernelSize}}{{formatBytes .KernelSize}}{{else}}—{{end}}</span>
                    <span>Initrd</span><span>{{if .InitrdSize}}{{formatBytes .InitrdSize}}{{else}}—{{end}}</span>
                    <span>Created</span><span><time datetime="{{rfc3339 .CreatedAt}}" data-time="datetime">{{utcLabel .CreatedAt "2006-01-02 15:04"}}</time></span>
                </div>
                <div class="actions">
                    <button class="b sm" type="button" onclick="showOSImageInfo('{{.ID}}')">Info</button>
                    {{if not .Active}}
                    <button class="b dg sm"
                            hx-delete="/osimages/delete/{{.ID}}"
                            hx-swap="none"
                            hx-on::after-request="if (event.detail.successful) window.location.reload()"
                            hx-confirm="Delete this OS image?">Delete…</button>
                    {{end}}
                </div>
            </article>
            {{end}}
        </div>
        <div class="console-view scroll">
            <table>
                <thead>
                    <tr>
                        <th>OS</th><th>Version</th><th>Arch</th><th>Kernel</th><th>Initrd</th><th>Created</th><th class="acts">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .OSImages}}
                    <tr data-eol="{{if .EOL}}true{{else}}false{{end}}">
                        <td><span class="ico {{.OS}}">{{initial .OS}}</span>{{.OS}}</td>
                        <td class="mono">{{.Version}}{{if .EOL}} {{template "eol-badge" .}}{{end}}</td>
                        <td>{{.Architecture}}</td>
                        <td>{{if .KernelSize}}{{formatBytes .KernelSize}}{{else}}—{{end}}</td>
                        <td>{{if .InitrdSize}}{{formatBytes .InitrdSize}}{{else}}—{{end}}</td>
                        <td><time datetime="{{rfc3339 .CreatedAt}}" data-time="datetime">{{utcLabel .CreatedAt "2006-01-02 15:04"}}</time></td>
                        <td class="acts">
                            <div class="actions stable">
                                <button class="b sm" type="button" onclick="showOSImageInfo('{{.ID}}')">Info</button>
                                {{if not .Active}}
                                <button class="b dg sm"
                                        hx-delete="/osimages/delete/{{.ID}}"
                                        hx-swap="none"
                                        hx-on::after-request="if (event.detail.successful) window.location.reload()"
                                        hx-confirm="Delete this OS image?">Delete…</button>
                                {{end}}
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="note">
            <p>No OS images yet. Download a kernel and initrd to boot from.</p>
        </div>
        {{end}}
    </section>

    <section class="panel">
        <div class="ph">
            <h3>Download an image</h3>
            <span class="mu">kernel + initrd</span>
        </div>
        <form id="download-form" hx-post="/osimages/download" hx-swap="none" hx-on::after-request="handleDownloadResponse(event)">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            {{$chosenOS := ""}}
            {{$chosenArch := ""}}
            {{if .Catalog.OSes}}{{$chosenOS = (index .Catalog.OSes 0).OS}}{{end}}
            {{if .Architectures}}{{$chosenArch = index .Architectures 0}}{{end}}
            <div class="fld">
                <label for="os">Operating system</label>
                <select id="os" name="os" class="select select-bordered w-full" required onchange="updateVersions()">
                    <option value="">Select OS</option>
                    {{range .Catalog.OSes}}
                    <option value="{{.OS}}" {{if eq .OS $chosenOS}}selected{{end}}>{{.DisplayName}}</option>
                    {{end}}
                </select>
            </div>
            <div class="fld">
                <label for="versionSelect">Version</label>
                <select name="version" id="versionSelect" class="select select-bordered w-full" required>
                    <option value="">Select version</option>
                    {{range .Catalog.OSes}}
                    {{$os := .}}
                    <optgroup label="{{$os.DisplayName}}" data-os="{{$os.OS}}">
                        {{range $os.Versions}}
                        <option value="{{.Value}}" data-os="{{$os.OS}}" data-arch="{{.Arch}}" data-latest="{{if .Latest}}true{{else}}false{{end}}" data-eol="{{if .EOL}}true{{else}}false{{end}}"{{if .EOLDate}} data-eol-date="{{.EOLDate}}"{{end}}{{if and .Latest (eq $os.OS $chosenOS) (eq .Arch $chosenArch)}} selected{{end}}>{{.DisplayName}}{{if .Latest}} · latest{{end}}{{if .EOL}} · EOL{{if .EOLDate}} {{.EOLDate}}{{end}}{{end}}</option>
                        {{end}}
                    </optgroup>
                    {{end}}
                </select>
                <label class="checkline" for="include-eol">
                    <input type="checkbox" id="include-eol" onchange="updateVersions()">
                    <span>Show end-of-life versions</span>
                </label>
            </div>
            <div class="fld">
                <label for="architecture">Architecture</label>
                <select id="architecture" name="architecture" class="select select-bordered w-full" onchange="updateVersions()">
                    {{range .Architectures}}
                    <option value="{{.}}">{{.}}</option>
                    {{end}}
                </select>
            </div>
            <div class="fld">
                {{template "catalog-status.templ" .}}
            </div>
            <div class="ipxe-note">
                <b>iPXE boot menu</b>
                <span class="mu">Regenerate after adding or removing images.</span>
                <div style="margin-top:8px">
                    <button class="b sm" type="button" hx-post="/ipxe/update" hx-swap="none">Regenerate iPXE config</button>
                </div>
            </div>
            <div class="panel-foot">
                <button type="submit" class="b p sm">Start download</button>
                <button type="reset" class="b sm">Reset</button>
            </div>
        </form>
    </section>
</div>

<dialog id="infoModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">OS image</h3>
        <div id="osImageInfo"></div>
        <div class="modal-action">
            <button type="button" class="btn" onclick="document.getElementById('infoModal').close()">Close</button>
        </div>
    </div>
</dialog>

<script>
function selectedArch() {
    var arch = document.getElementById('architecture');
    return arch ? arch.value : '';
}

function versionLabel(info) {
    var label = info.display_name || info.value || '';
    if (info.latest) label += ' · latest';
    if (info.eol) {
        label += ' · EOL';
        if (info.eol_date) label += ' ' + info.eol_date;
    }
    return label;
}

function syncVersionOptions() {
    var osSelect = document.getElementById('os');
    var versionSelect = document.getElementById('versionSelect');
    if (!osSelect || !versionSelect) return;
    var os = osSelect.value;
    var arch = selectedArch();
    var includeEOL = document.getElementById('include-eol');
    var wantEOL = includeEOL ? includeEOL.checked : false;
    var latest = null;
    var first = null;
    versionSelect.querySelectorAll('optgroup').forEach(function (group) {
        var matchOS = group.getAttribute('data-os') === os;
        group.hidden = !matchOS;
        group.disabled = !matchOS;
        group.querySelectorAll('option').forEach(function (option) {
            var optionArch = option.getAttribute('data-arch') || '';
            var matchArch = !arch || optionArch === arch;
            var eol = option.getAttribute('data-eol') === 'true';
            var show = matchOS && matchArch && (wantEOL || !eol);
            option.hidden = !show;
            option.disabled = !show;
            if (!show) return;
            if (!first) first = option;
            if (option.getAttribute('data-latest') === 'true') latest = option;
        });
    });
    var pick = latest || first;
    versionSelect.value = pick ? pick.value : '';
}

function loadEOLVersions(os) {
    return fetch('/osimages/available-versions?os=' + encodeURIComponent(os) + '&include_eol=true', {
        headers: { 'Accept': 'application/json' }
    }).then(function (response) {
        if (!response.ok) throw new Error('Failed to fetch versions');
        return response.json();
    }).then(function (versions) {
        if (!Array.isArray(versions) || document.getElementById('os').value !== os) return;
        var versionSelect = document.getElementById('versionSelect');
        var group = null;
        versionSelect.querySelectorAll('optgroup').forEach(function (candidate) {
            if (candidate.getAttribute('data-os') === os) group = candidate;
        });
        if (!group) return;
        versions.forEach(function (info) {
            if (!info || !info.eol) return;
            var arch = info.arch || '';
            var exists = false;
            group.querySelectorAll('option').forEach(function (option) {
                if (option.value === info.value && (option.getAttribute('data-arch') || '') === arch) exists = true;
            });
            if (exists) {
                group.querySelectorAll('option').forEach(function (option) {
                    if (option.value === info.value && (option.getAttribute('data-arch') || '') === arch) {
                        option.textContent = versionLabel(info);
                        option.setAttribute('data-eol', 'true');
                        if (info.eol_date) option.setAttribute('data-eol-date', info.eol_date);
                    }
                });
                return;
            }
            var option = document.createElement('option');
            option.value = info.value || '';
            option.textContent = versionLabel(info);
            option.setAttribute('data-os', os);
            option.setAttribute('data-arch', arch);
            option.setAttribute('data-latest', info.latest ? 'true' : 'false');
            option.setAttribute('data-eol', 'true');
            if (info.eol_date) option.setAttribute('data-eol-date', info.eol_date);
            option.setAttribute('data-injected', 'true');
            group.appendChild(option);
        });
    });
}

function updateVersions() {
    var osSelect = document.getElementById('os');
    var os = osSelect ? osSelect.value : '';
    var includeEOL = document.getElementById('include-eol');
    if (includeEOL && includeEOL.checked && os) {
        loadEOLVersions(os).then(syncVersionOptions).catch(function () { syncVersionOptions(); });
        return;
    }
    syncVersionOptions();
}

function showOSImageInfo(imageId) {
    fetch('/osimages/info/' + encodeURIComponent(imageId))
        .then(function (response) { return response.json(); })
        .then(function (data) {
            var rows = [
                ['ID', data.id, 'mono'],
                ['OS', data.os, ''],
                ['Version', data.version, ''],
                ['Arch', data.architecture, ''],
                ['Kernel', data.kernel_path, 'mono'],
                ['Initrd', data.initrd_path, 'mono'],
                ['Kernel size', formatBytes(data.kernel_size), ''],
                ['Initrd size', formatBytes(data.initrd_size), '']
            ];
            if (data.eol) rows.push(['End of life', data.eol_date ? String(data.eol_date) : 'Yes', '']);
            fillFacts(document.getElementById('osImageInfo'), rows);
            document.getElementById('infoModal').showModal();
        })
        .catch(function () { alert('Failed to load OS image information'); });
}

function fillFacts(el, rows) {
    el.replaceChildren();
    var grid = document.createElement('div');
    grid.className = 'kv';
    rows.forEach(function (row) {
        var label = document.createElement('span');
        label.textContent = row[0];
        var value = document.createElement('span');
        if (row[2]) value.className = row[2];
        value.textContent = row[1] == null ? '' : String(row[1]);
        grid.appendChild(label);
        grid.appendChild(value);
    });
    el.appendChild(grid);
}

function formatBytes(bytes) {
    if (!bytes) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

updateVersions();

function handleDownloadResponse(event) {
    const xhr = event.detail.xhr;
    if (!xhr || xhr.status !== 200) return;
    try {
        const response = JSON.parse(xhr.responseText);
        if (response.status === 'started') {
            setTimeout(function () { window.location.reload(); }, 600);
        }
    } catch (e) {
        console.error('Error parsing response:', e);
    }
}
</script>
{{ end }}

{{define "eol-badge"}}<span class="st wa eol-badge" title="{{if .EOLDate}}End of life {{.EOLDate}}{{else}}End of life{{end}}">EOL{{if .EOLDate}} {{.EOLDate}}{{end}}</span>{{end}}
