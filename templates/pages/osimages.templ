{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">OS Images</span><span class="only-console">osimages</span></h1>
        <p class="sub only-cozy">{{len .OSImages}} images on disk</p>
        <p class="sub only-console">{{len .OSImages}} images</p>
    </div>
    <div class="actions">
        <button class="b p" type="button" onclick="document.getElementById('downloadModal').showModal()">Download image</button>
        <button class="b" type="button"
                hx-post="/ipxe/update"
                hx-swap="none"
                hx-on::after-request="handleIPXEResponse(event)">Regenerate iPXE</button>
    </div>
</header>

<div id="active-downloads" class="mt"{{if .Downloads}} hx-get="/osimages" hx-select="#active-downloads" hx-trigger="every 5s" hx-swap="outerHTML"{{end}}>
{{if .Downloads}}
<section class="panel">
    <div class="pad"><b>Active downloads</b></div>
    <div class="scroll">
        <table>
            <thead>
                <tr><th>OS</th><th>Version</th><th>Status</th><th>Progress</th><th>Started</th><th></th></tr>
            </thead>
            <tbody>
                {{range .Downloads}}
                <tr>
                    <td>{{.OS}}</td>
                    <td class="mono">{{.Version}}</td>
                    <td><span class="st in">{{.Status}}</span></td>
                    <td><span class="prog"><i style="width: {{.Progress}}%"></i></span> {{.Progress}}%</td>
                    <td>{{.StartedAt.Format "15:04:05"}}</td>
                    <td>
                        {{if or (eq .Status "downloading") (eq .Status "queued")}}
                        <button class="b dg sm" hx-post="/osimages/cancel/{{.ID}}" hx-confirm="Cancel this download?">Cancel</button>
                        {{end}}
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
</section>
{{end}}
</div>

<section class="panel mt">
    {{if .OSImages}}
    <div class="cozy-view cards">
        {{range .OSImages}}
        <article class="cd" style="cursor: default;">
            <div class="r">
                <span><span class="ico {{.OS}}">{{initial .OS}}</span>{{.OS}}</span>
                <span class="mono">{{.Version}}</span>
            </div>
            <div class="kv">
                <span>Arch</span><span>{{.Architecture}}</span>
                <span>Kernel</span><span>{{if .KernelSize}}{{formatBytes .KernelSize}}{{else}}—{{end}}</span>
                <span>Initrd</span><span>{{if .InitrdSize}}{{formatBytes .InitrdSize}}{{else}}—{{end}}</span>
                <span>Added</span><span>{{.CreatedAt.Format "2006-01-02 15:04"}}</span>
            </div>
            <div class="actions">
                <button class="b sm" type="button" onclick="showOSImageInfo('{{.ID}}')">Info</button>
                {{if not .Active}}
                <button class="b dg sm"
                        hx-delete="/osimages/delete/{{.ID}}"
                        hx-swap="none"
                        hx-on::after-request="if (event.detail.successful) window.location.reload()"
                        hx-confirm="Delete this OS image?">Delete</button>
                {{end}}
            </div>
        </article>
        {{end}}
    </div>
    <div class="console-view scroll">
        <table>
            <thead>
                <tr>
                    <th>OS</th><th>Version</th><th>Arch</th><th>Kernel</th><th>Initrd</th><th>Added</th><th></th>
                </tr>
            </thead>
            <tbody>
                {{range .OSImages}}
                <tr>
                    <td><span class="ico {{.OS}}">{{initial .OS}}</span>{{.OS}}</td>
                    <td class="mono">{{.Version}}</td>
                    <td>{{.Architecture}}</td>
                    <td>{{if .KernelSize}}{{formatBytes .KernelSize}}{{else}}—{{end}}</td>
                    <td>{{if .InitrdSize}}{{formatBytes .InitrdSize}}{{else}}—{{end}}</td>
                    <td>{{.CreatedAt.Format "2006-01-02 15:04"}}</td>
                    <td>
                        <button class="b sm" type="button" onclick="showOSImageInfo('{{.ID}}')">Info</button>
                        {{if not .Active}}
                        <button class="b dg sm"
                                hx-delete="/osimages/delete/{{.ID}}"
                                hx-swap="none"
                                hx-on::after-request="if (event.detail.successful) window.location.reload()"
                                hx-confirm="Delete this OS image?">Delete</button>
                        {{end}}
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="note">
        <p>No OS images yet. Download a kernel and initrd to boot from.</p>
        <button class="b p sm mt" type="button" onclick="document.getElementById('downloadModal').showModal()">Download image</button>
    </div>
    {{end}}
</section>

<dialog id="downloadModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Download OS image</h3>
        <form hx-post="/osimages/download" hx-swap="none" hx-on::after-request="handleDownloadResponse(event)">
            <div class="form-control mb-4">
                <label class="label"><span class="label-text">Operating system</span></label>
                <select name="os" class="select select-bordered w-full" required onchange="updateVersions(this.value)">
                    <option value="">Select OS</option>
                    <option value="ubuntu">Ubuntu</option>
                    <option value="debian">Debian</option>
                    <option value="fedora">Fedora</option>
                    <option value="centos">CentOS</option>
                    <option value="opensuse">openSUSE</option>
                    <option value="nixos">NixOS</option>
                </select>
            </div>
            <div class="form-control mb-4">
                <label class="label"><span class="label-text">Version</span></label>
                <select name="version" id="versionSelect" class="select select-bordered w-full" required>
                    <option value="">Select version first</option>
                </select>
            </div>
            <div class="form-control mb-4">
                <label class="label"><span class="label-text">Architecture</span></label>
                <select name="architecture" class="select select-bordered w-full">
                    {{range .Architectures}}
                    <option value="{{.}}">{{.}}</option>
                    {{end}}
                </select>
            </div>
            <div class="modal-action">
                <button type="button" class="btn" onclick="document.getElementById('downloadModal').close()">Cancel</button>
                <button type="submit" class="btn btn-primary">Start download</button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="infoModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">OS image</h3>
        <div id="osImageInfo"></div>
        <div class="modal-action">
            <button type="button" class="btn" onclick="document.getElementById('infoModal').close()">Close</button>
        </div>
    </div>
</dialog>

<script>
function updateVersions(os) {
    const versionSelect = document.getElementById('versionSelect');
    versionSelect.innerHTML = '<option value="">Select version</option>';
    if (!os) return;
    fetch('/osimages/available-versions?os=' + encodeURIComponent(os))
        .then(function (response) {
            if (!response.ok) throw new Error('Failed to fetch versions');
            return response.json();
        })
        .then(function (versions) {
            versions.forEach(function (versionInfo) {
                const option = document.createElement('option');
                option.value = versionInfo.value;
                option.textContent = versionInfo.display_name;
                versionSelect.appendChild(option);
            });
        })
        .catch(function (error) { console.error('Error fetching versions:', error); });
}

function showOSImageInfo(imageId) {
    fetch('/osimages/info/' + encodeURIComponent(imageId))
        .then(function (response) { return response.json(); })
        .then(function (data) {
            document.getElementById('osImageInfo').innerHTML =
                '<div class="kv">' +
                '<span>ID</span><span class="mono">' + data.id + '</span>' +
                '<span>OS</span><span>' + data.os + '</span>' +
                '<span>Version</span><span>' + data.version + '</span>' +
                '<span>Arch</span><span>' + data.architecture + '</span>' +
                '<span>Kernel</span><span class="mono">' + data.kernel_path + '</span>' +
                '<span>Initrd</span><span class="mono">' + data.initrd_path + '</span>' +
                '<span>Kernel size</span><span>' + formatBytes(data.kernel_size) + '</span>' +
                '<span>Initrd size</span><span>' + formatBytes(data.initrd_size) + '</span>' +
                '</div>';
            document.getElementById('infoModal').showModal();
        })
        .catch(function () { alert('Failed to load OS image information'); });
}

function formatBytes(bytes) {
    if (!bytes) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function handleDownloadResponse(event) {
    const xhr = event.detail.xhr;
    if (xhr.status !== 200) return;
    try {
        const response = JSON.parse(xhr.responseText);
        if (response.status === 'started') {
            document.getElementById('downloadModal').close();
            Toastify({ text: response.message, duration: 5000, close: true, gravity: "top", position: "right", backgroundColor: "linear-gradient(to right, #00b09b, #96c93d)" }).showToast();
            setTimeout(function () { window.location.reload(); }, 1000);
        }
    } catch (e) {
        console.error('Error parsing response:', e);
    }
}

function handleIPXEResponse(event) {
    const xhr = event.detail.xhr;
    Toastify({
        text: xhr.status === 200 ? "iPXE configuration regenerated successfully" : "Failed to regenerate iPXE configuration",
        duration: xhr.status === 200 ? 3000 : 5000,
        close: true,
        gravity: "top",
        position: "right",
        backgroundColor: xhr.status === 200 ? "linear-gradient(to right, #00b09b, #96c93d)" : "linear-gradient(to right, #ff5f6d, #ffc371)"
    }).showToast();
}
</script>
{{ end }}
