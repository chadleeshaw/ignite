{{define "content"}}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">DHCP</span><span class="only-console">dhcp</span></h1>
        <p class="sub only-cozy">{{countPhrase (len .Servers) "server" "servers"}}</p>
        <p class="sub only-console">{{countPhrase (len .Servers) "server" "servers"}}</p>
    </div>
    <div class="actions">
        <button id="new-dhcp-btn"
            hx-get="/open_modal?template=dhcpmodal"
            hx-target="#modal-content"
           
            class="b p">New server</button>
    </div>
</header>

{{if not .Servers}}
<p class="note mt">No DHCP servers yet. Add one to hand out addresses.</p>
{{else}}
<section class="stats strip mt" aria-label="DHCP pool">
    <div class="stat">
        <div class="stat-title">Pool</div>
        <div class="stat-value">{{.Strip.Free}} <span class="stat-unit">free</span></div>
        <div class="stat-desc">{{.Strip.Used}} used / {{.Strip.Total}} total</div>
    </div>
    <div class="stat">
        <div class="stat-title">Reserved</div>
        <div class="stat-value">{{.Strip.Reserved}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">Expired</div>
        <div class="stat-value">{{.Strip.Expired}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">In flight</div>
        <div class="stat-value warn">{{.Strip.InFlight}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">Failed</div>
        <div class="stat-value bad">{{.Strip.Failed}}</div>
    </div>
    <div class="stat">
        <div class="stat-title">Last refresh</div>
        <div class="stat-value"><time {{if not .Strip.Refreshed.IsZero}}datetime="{{rfc3339 .Strip.Refreshed}}" data-time="clock"{{end}}>{{if .Strip.Refreshed.IsZero}}—{{else}}{{utcLabel .Strip.Refreshed "15:04:05"}}{{end}}</time></div>
        <div class="stat-desc" data-zone>UTC</div>
    </div>
</section>
<div class="main">
<div class="dhcp-servers">
{{range .Servers}}
<section class="panel">
    <div class="pad" style="justify-content: space-between;">
        <div>
            <span class="ip">{{.TFTPIP}}</span>
            <span class="st {{dhcpStateClass .Status}}" data-status="{{.Status}}">{{dhcpStateLabel .Status}}</span>
            <p class="mu" style="margin-top:4px">
                {{if gt .LeaseRange 0}}{{.Free}} free · {{.Used}} used / {{.LeaseRange}} total{{else}}pool size not set{{end}}{{if eq .Status "configured"}} · not started yet{{end}}
            </p>
        </div>
        <div class="actions stable">
            {{if eq .Status "running"}}
            <button class="b dg sm" hx-post="/dhcp/stop?server_id={{.ID}}" hx-swap="none"><span class="label-fit"><span>Stop</span><span aria-hidden="true">Start</span><span aria-hidden="true">Stop</span></span></button>
            {{else}}
            <button class="b sm" hx-post="/dhcp/start?server_id={{.ID}}" hx-swap="none"><span class="label-fit"><span>Start</span><span aria-hidden="true">Start</span><span aria-hidden="true">Stop</span></span></button>
            {{end}}
            <button class="b sm" hx-get="/open_modal?template=dhcpmodal&server_id={{.ID}}" hx-target="#modal-content">Edit</button>
            <button class="b dg sm" hx-post="/dhcp/delete?server_id={{.ID}}" hx-swap="none" hx-confirm="Delete this DHCP server?">Delete</button>
        </div>
    </div>

    {{ $tftpip := .TFTPIP }}
    <div class="cozy-view">
        {{if .Leases}}
        <div class="cards">
            {{range .Leases}}
            <button type="button" class="cd lease-pick"
                data-mac="{{.MAC}}"
                data-ip="{{.IP}}"
                data-state="{{.StateDisplayName}}"
                data-seen="{{relTime .LastSeen}}"
                data-seen-at="{{rfc3339 .LastSeen}}"
                data-seen-title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{utcLabel .LastSeen "2006-01-02 15:04:05"}}{{end}}"
                data-menu="{{if menuName .MenuName}}{{menuName .MenuName}}{{else}}—{{end}}"
                data-ipmi="{{if .IPMI.Username}}{{.IPMI.Username}}{{else}}none{{end}}"
                data-reserved="{{if .Static}}yes{{else}}no{{end}}"
                onclick="selectLease(this)">
                <div class="r">
                    <b class="ip">{{.IP}}</b>
                    <span class="badge lease-state {{.StateBadgeClass}}" data-mac="{{.MAC}}">{{.StateDisplayName}}</span>
                </div>
                <div class="kv">
                    <span>MAC</span><span class="mono">{{.MAC}}</span>
                    <span>Seen</span><span><time {{if not .LastSeen.IsZero}}datetime="{{rfc3339 .LastSeen}}" data-time="title"{{end}} title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{utcLabel .LastSeen "2006-01-02 15:04:05"}}{{end}}">{{relTime .LastSeen}}</time></span>
                    <span>Menu</span><span>{{if menuName .MenuName}}{{menuName .MenuName}}{{else}}—{{end}}</span>
                </div>
            </button>
            {{end}}
        </div>
        {{else}}
        <p class="note">No leases on this server.</p>
        {{end}}
    </div>

    <div class="lease-rows">
        <table class="lease-table">
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>IP</th>
                    <th>State</th>
                    <th>Last seen</th>
                    <th>Menu</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Leases}}
                <tr class="lease-pick"
                    tabindex="0"
                    data-mac="{{.MAC}}"
                    data-ip="{{.IP}}"
                    data-state="{{.StateDisplayName}}"
                    data-seen="{{relTime .LastSeen}}"
                    data-seen-at="{{rfc3339 .LastSeen}}"
                    data-seen-title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{utcLabel .LastSeen "2006-01-02 15:04:05"}}{{end}}"
                    data-menu="{{if menuName .MenuName}}{{menuName .MenuName}}{{else}}—{{end}}"
                    data-ipmi="{{if .IPMI.Username}}{{.IPMI.Username}}{{else}}none{{end}}"
                    data-reserved="{{if .Static}}yes{{else}}no{{end}}"
                    onclick="selectLease(this)"
                    onkeydown="leasePickKey(event, this)">
                    <td class="mono">{{.MAC}}</td>
                    <td class="ip">{{.IP}}</td>
                    <td><span class="badge lease-state {{.StateBadgeClass}}" data-mac="{{.MAC}}">{{.StateDisplayName}}</span></td>
                    <td><time {{if not .LastSeen.IsZero}}datetime="{{rfc3339 .LastSeen}}" data-time="title"{{end}} title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{utcLabel .LastSeen "2006-01-02 15:04:05"}}{{end}}">{{relTime .LastSeen}}</time></td>
                    <td class="menu-name">{{if menuName .MenuName}}{{menuName .MenuName}}{{else}}—{{end}}</td>
                    <td class="acts">
                        <div class="actions stable">
                            <button class="b sm" hx-get="/open_modal?template=reservemodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content"><span class="label-fit"><span>{{if .Static}}Reserved{{else}}Reserve{{end}}</span><span aria-hidden="true">Reserve</span><span aria-hidden="true">Reserved</span></span></button>
                            <button class="b sm {{if menuName .MenuName}}p{{end}}" hx-get="/open_modal?template=bootmodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content">Boot menu</button>
                            <button class="b sm {{if .IPMI.Username}}p{{end}}" hx-get="/open_modal?template=ipmimodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content">IPMI</button>
                            <div class="dropdown dropdown-end">
                                <button class="b sm" tabindex="0" type="button">State</button>
                                <ul tabindex="0" class="dropdown-content z-[9999] menu p-2 shadow bg-base-100 rounded-box w-52">
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'assigned')">Assigned</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'pxe_requested')">PXE Requested</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'booting')">Booting</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'imaging')">Imaging</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'imaged')">Imaged</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'configuring')">Configuring</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'complete')">Complete</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'failed')">Failed</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'offline')">Offline</a></li>
                                </ul>
                            </div>
                            <button class="b sm" type="button" onclick="showLeaseHistory('{{.MAC}}')">History</button>
                            <button class="b dg sm" hx-post="/dhcp/delete_lease?mac={{.MAC}}" hx-swap="none" hx-confirm="Delete this lease?">Delete</button>
                        </div>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="6">No leases on this server.</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div class="pad">
        <button class="b sm p" hx-get="/open_modal?template=manualleasemodal&network={{.TFTPIP}}" hx-target="#modal-content">Add manual lease</button>
    </div>
</section>
{{end}}
</div>

<aside class="panel" id="lease-detail">
    <div class="ph"><h3 id="det-title">Host details</h3></div>
    <p class="note" id="det-empty">Select a host</p>
    <div class="det" id="lease-detail-body" hidden>
        <span>MAC</span><span id="det-mac">—</span>
        <span>IP</span><span id="det-ip">—</span>
        <span>State</span><span id="det-state">—</span>
        <span>Seen</span><span id="det-seen">—</span>
        <span>Reserved</span><span id="det-reserved">—</span>
        <span>Menu</span><span id="det-menu">—</span>
        <span>IPMI</span><span id="det-ipmi">—</span>
    </div>
</aside>
</div>
{{end}}

<script>
function toast(message, isSuccess) {
    igniteToast(message, isSuccess);
}

function leasePickKey(event, el) {
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    selectLease(el);
}

var stateDisplayNames = {
    'assigned': 'Assigned',
    'pxe_requested': 'PXE Requested',
    'booting': 'Booting',
    'imaging': 'Imaging',
    'imaged': 'Imaged',
    'configuring': 'Configuring',
    'complete': 'Complete',
    'failed': 'Failed',
    'offline': 'Offline'
};

function selectLease(el) {
    var mac = el.getAttribute('data-mac');
    document.querySelectorAll('.lease-pick').forEach(function (node) {
        node.classList.toggle('sel', node.getAttribute('data-mac') === mac);
    });
    document.getElementById('det-title').textContent = el.getAttribute('data-ip') || 'Lease';
    document.getElementById('det-empty').hidden = true;
    document.getElementById('lease-detail-body').hidden = false;
    document.getElementById('det-mac').textContent = el.getAttribute('data-mac');
    document.getElementById('det-ip').textContent = el.getAttribute('data-ip');
    document.getElementById('det-state').textContent = el.getAttribute('data-state');
    var seen = document.getElementById('det-seen');
    seen.textContent = el.getAttribute('data-seen');
    var seenAt = el.getAttribute('data-seen-at');
    if (seenAt) {
        var seenDate = new Date(seenAt);
        seen.title = isNaN(seenDate.getTime()) ? (el.getAttribute('data-seen-title') || '') : seenDate.toLocaleString();
    } else {
        seen.title = el.getAttribute('data-seen-title') || '';
    }
    document.getElementById('det-reserved').textContent = el.getAttribute('data-reserved');
    document.getElementById('det-menu').textContent = el.getAttribute('data-menu');
    document.getElementById('det-ipmi').textContent = el.getAttribute('data-ipmi');
}

function updateLeaseState(mac, newState) {
    if (!newState) return;
    var formData = new FormData();
    formData.append('state', newState);
    formData.append('source', 'manual');
    igniteFetch('/dhcp/lease/state?mac=' + encodeURIComponent(mac), { method: 'POST', body: formData })
        .then(function (response) {
            return response.text().then(function (text) {
                var data = {};
                try { data = JSON.parse(text); } catch (err) {}
                if (response.ok && data.success) {
                    document.querySelectorAll('.lease-state').forEach(function (badge) {
                        if (badge.getAttribute('data-mac') !== mac) return;
                        badge.className = 'badge lease-state ' + getStateBadgeClass(newState);
                        badge.textContent = stateDisplayNames[newState] || newState;
                    });
                    toast('Lease state updated to ' + (stateDisplayNames[newState] || newState), true);
                    return;
                }
                toast(igniteResponseMessage({ responseText: text }, 'Failed to update lease state'), false);
            });
        })
        .catch(function () { toast('Failed to update lease state', false); });
}

function showLeaseHistory(mac) {
    fetch('/dhcp/lease/history?mac=' + encodeURIComponent(mac))
        .then(function (response) { return response.json(); })
        .then(function (data) {
            closeHistoryModal();
            var modal = document.createElement("div");
            modal.id = "lease-history-modal";
            modal.className = "modal modal-open";
            var box = document.createElement("div");
            box.className = "modal-box";
            var title = document.createElement("h3");
            title.className = "font-bold text-lg";
            title.textContent = "Lease history for " + mac;
            var body = document.createElement("div");
            body.className = "py-4";
            var history = data.history || [];
            if (!history.length) {
                var empty = document.createElement("p");
                empty.className = "mu";
                empty.textContent = "No history available for this lease.";
                body.appendChild(empty);
            } else {
                history.forEach(function (entry) {
                    var row = document.createElement("div");
                    row.className = "flex justify-between items-center py-2 border-b";
                    var left = document.createElement("div");
                    var badge = document.createElement("span");
                    badge.className = "badge " + getStateBadgeClass(entry.to_state);
                    badge.textContent = stateDisplayNames[entry.to_state] || entry.to_state || "";
                    var source = document.createElement("span");
                    source.className = "mu";
                    source.textContent = entry.source ? " " + entry.source : "";
                    left.appendChild(badge);
                    left.appendChild(source);
                    var when = document.createElement("span");
                    when.className = "mu";
                    when.textContent = entry.timestamp ? new Date(entry.timestamp).toLocaleString() : "";
                    row.appendChild(left);
                    row.appendChild(when);
                    body.appendChild(row);
                });
            }
            var actions = document.createElement("div");
            actions.className = "modal-action";
            var close = document.createElement("button");
            close.type = "button";
            close.className = "btn";
            close.textContent = "Close";
            close.addEventListener("click", closeHistoryModal);
            actions.appendChild(close);
            box.appendChild(title);
            box.appendChild(body);
            box.appendChild(actions);
            modal.appendChild(box);
            document.body.appendChild(modal);
        })
        .catch(function () { toast('Failed to load lease history', false); });
}

function closeHistoryModal() {
    var modal = document.getElementById("lease-history-modal");
    if (modal) modal.remove();
}

function getStateBadgeClass(state) {
    var stateClasses = {
        'assigned': 'badge-info',
        'pxe_requested': 'badge-warning',
        'booting': 'badge-warning',
        'imaging': 'badge-accent',
        'imaged': 'badge-success',
        'configuring': 'badge-accent',
        'complete': 'badge-success',
        'failed': 'badge-error',
        'offline': 'badge-ghost'
    };
    return stateClasses[state] || 'badge-ghost';
}
</script>
{{end}}
