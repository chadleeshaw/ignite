{{define "content"}}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">DHCP</span><span class="only-console">dhcp</span></h1>
        <p class="sub only-cozy">{{len .Servers}} servers</p>
        <p class="sub only-console">{{len .Servers}} servers</p>
    </div>
    <div class="actions">
        <button id="new-dhcp-btn"
            hx-get="/open_modal?template=dhcpmodal"
            hx-target="#modal-content"
            hx-swap="innerHTML"
            class="b p">New server</button>
    </div>
</header>

{{if not .Servers}}
<p class="note mt">No DHCP servers yet. Add one to hand out addresses.</p>
{{end}}

{{range .Servers}}
<section class="panel mt">
    <div class="pad" style="justify-content: space-between;">
        <div>
            <span class="ip">{{.TFTPIP}}</span>
            {{if .Running}}
            <span class="st ok">running</span>
            {{else}}
            <span class="st er">stopped</span>
            {{end}}
            <p class="mu" style="margin-top:4px">
                {{if gt .LeaseRange 0}}{{.Free}} free · {{.Used}} used / {{.LeaseRange}} total{{else}}pool size not set{{end}}
            </p>
        </div>
        <div class="actions">
            {{if .Running}}
            <button class="b dg sm" hx-post="/dhcp/stop?server_id={{.ID}}" hx-swap="none">Stop</button>
            {{else}}
            <button class="b sm" hx-post="/dhcp/start?server_id={{.ID}}" hx-swap="none">Start</button>
            {{end}}
            <button class="b sm" hx-get="/open_modal?template=dhcpmodal&server_id={{.ID}}" hx-target="#modal-content" hx-swap="innerHTML">Edit</button>
            <button class="b dg sm" hx-post="/dhcp/delete?server_id={{.ID}}" hx-swap="none" hx-confirm="Delete this DHCP server?">Delete</button>
        </div>
    </div>

    {{ $tftpip := .TFTPIP }}
    <div class="cozy-view">
        {{if .Leases}}
        <div class="cards">
            {{range .Leases}}
            <button type="button" class="cd lease-pick"
                data-mac="{{.MAC}}"
                data-ip="{{.IP}}"
                data-state="{{.StateDisplayName}}"
                data-seen="{{relTime .LastSeen}}"
                data-seen-title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{.LastSeen.Format "2006-01-02 15:04:05"}}{{end}}"
                data-menu="{{if .Menu.Filename}}{{.Menu.OS}} {{.Menu.Version}}{{else}}none{{end}}"
                data-ipmi="{{if .IPMI.Username}}{{.IPMI.Username}}{{else}}none{{end}}"
                data-reserved="{{if .Static}}yes{{else}}no{{end}}"
                onclick="selectLease(this)">
                <div class="r">
                    <b class="ip">{{.IP}}</b>
                    <span class="badge lease-state {{.StateBadgeClass}}" data-mac="{{.MAC}}">{{.StateDisplayName}}</span>
                </div>
                <div class="kv">
                    <span>MAC</span><span class="mono">{{.MAC}}</span>
                    <span>Seen</span>
                    <span title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{.LastSeen.Format "2006-01-02 15:04:05"}}{{end}}">{{relTime .LastSeen}}</span>
                    <span>Menu</span><span>{{if .Menu.Filename}}{{.Menu.Filename}}{{else}}—{{end}}</span>
                </div>
            </button>
            {{end}}
        </div>
        {{else}}
        <p class="note">No leases on this server.</p>
        {{end}}
    </div>

    <div class="console-view scroll">
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>IP</th>
                    <th>State</th>
                    <th>Seen</th>
                    <th>Reserved</th>
                    <th>Menu</th>
                    <th>IPMI</th>
                </tr>
            </thead>
            <tbody>
                {{range .Leases}}
                <tr class="lease-pick"
                    data-mac="{{.MAC}}"
                    data-ip="{{.IP}}"
                    data-state="{{.StateDisplayName}}"
                    data-seen="{{relTime .LastSeen}}"
                    data-seen-title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{.LastSeen.Format "2006-01-02 15:04:05"}}{{end}}"
                    data-menu="{{if .Menu.Filename}}{{.Menu.OS}} {{.Menu.Version}}{{else}}none{{end}}"
                    data-ipmi="{{if .IPMI.Username}}{{.IPMI.Username}}{{else}}none{{end}}"
                    data-reserved="{{if .Static}}yes{{else}}no{{end}}"
                    onclick="selectLease(this)">
                    <td class="mono">{{.MAC}}</td>
                    <td class="ip">{{.IP}}</td>
                    <td><span class="badge lease-state {{.StateBadgeClass}}" data-mac="{{.MAC}}">{{.StateDisplayName}}</span></td>
                    <td title="{{if .LastSeen.IsZero}}No heartbeat recorded{{else}}{{.LastSeen.Format "2006-01-02 15:04:05"}}{{end}}">{{relTime .LastSeen}}</td>
                    <td>{{if .Static}}yes{{else}}no{{end}}</td>
                    <td>{{if .Menu.Filename}}{{.Menu.Filename}}{{else}}—{{end}}</td>
                    <td>{{if .IPMI.Username}}{{.IPMI.Username}}{{else}}—{{end}}</td>
                </tr>
                {{else}}
                <tr><td colspan="7">No leases on this server.</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Leases}}
                <tr>
                    <td class="mono">{{.MAC}}</td>
                    <td>
                        <div class="actions">
                            <button class="b sm" hx-get="/open_modal?template=reservemodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content" hx-swap="innerHTML">{{if .Static}}Reserved{{else}}Reserve{{end}}</button>
                            <button class="b sm {{if .Menu.Filename}}p{{end}}" hx-get="/open_modal?template=bootmodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content" hx-swap="innerHTML">Boot menu</button>
                            <button class="b sm {{if .IPMI.Username}}p{{end}}" hx-get="/open_modal?template=ipmimodal&network={{$tftpip}}&mac={{.MAC}}" hx-target="#modal-content" hx-swap="innerHTML">IPMI</button>
                            <div class="dropdown dropdown-end">
                                <button class="b sm" tabindex="0" type="button">State</button>
                                <ul tabindex="0" class="dropdown-content z-[9999] menu p-2 shadow bg-base-100 rounded-box w-52">
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'assigned')">Assigned</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'pxe_requested')">PXE Requested</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'booting')">Booting</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'imaging')">Imaging</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'imaged')">Imaged</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'configuring')">Configuring</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'complete')">Complete</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'failed')">Failed</a></li>
                                    <li><a onclick="updateLeaseState('{{.MAC}}', 'offline')">Offline</a></li>
                                </ul>
                            </div>
                            <button class="b sm" type="button" onclick="showLeaseHistory('{{.MAC}}')">History</button>
                            <button class="b dg sm" hx-post="/dhcp/delete_lease?mac={{.MAC}}" hx-swap="none" hx-confirm="Delete this lease?">Delete</button>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div class="pad">
        <button class="b sm p" hx-get="/open_modal?template=manualleasemodal&network={{.TFTPIP}}" hx-target="#modal-content" hx-swap="innerHTML">Add manual lease</button>
    </div>
</section>
{{end}}

<section class="panel mt" id="lease-detail">
    <div class="det" id="lease-detail-body">
        <span>Lease</span><span id="det-summary">Select a lease</span>
        <span>MAC</span><span id="det-mac">—</span>
        <span>IP</span><span id="det-ip">—</span>
        <span>State</span><span id="det-state">—</span>
        <span>Seen</span><span id="det-seen">—</span>
        <span>Reserved</span><span id="det-reserved">—</span>
        <span>Menu</span><span id="det-menu">—</span>
        <span>IPMI</span><span id="det-ipmi">—</span>
    </div>
</section>

<script>
function toast(message, isSuccess) {
    Toastify({
        text: message,
        duration: 3000,
        close: true,
        gravity: "top",
        position: "right",
        backgroundColor: isSuccess
            ? "linear-gradient(to right, #00b09b, #96c93d)"
            : "linear-gradient(to right, #FBBF24, #FF4500)",
    }).showToast();
}

var stateDisplayNames = {
    'assigned': 'Assigned',
    'pxe_requested': 'PXE Requested',
    'booting': 'Booting',
    'imaging': 'Imaging',
    'imaged': 'Imaged',
    'configuring': 'Configuring',
    'complete': 'Complete',
    'failed': 'Failed',
    'offline': 'Offline'
};

function selectLease(el) {
    document.querySelectorAll('.lease-pick.sel, tr.lease-pick.sel').forEach(function (node) {
        node.classList.remove('sel');
    });
    el.classList.add('sel');
    document.getElementById('det-summary').textContent = el.getAttribute('data-ip');
    document.getElementById('det-mac').textContent = el.getAttribute('data-mac');
    document.getElementById('det-ip').textContent = el.getAttribute('data-ip');
    document.getElementById('det-state').textContent = el.getAttribute('data-state');
    var seen = document.getElementById('det-seen');
    seen.textContent = el.getAttribute('data-seen');
    seen.title = el.getAttribute('data-seen-title') || '';
    document.getElementById('det-reserved').textContent = el.getAttribute('data-reserved');
    document.getElementById('det-menu').textContent = el.getAttribute('data-menu');
    document.getElementById('det-ipmi').textContent = el.getAttribute('data-ipmi');
}

function updateLeaseState(mac, newState) {
    if (!newState) return;
    var formData = new FormData();
    formData.append('state', newState);
    formData.append('source', 'manual');
    fetch('/dhcp/lease/state?mac=' + encodeURIComponent(mac), { method: 'POST', body: formData })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.status === 'success') {
                document.querySelectorAll('.lease-state').forEach(function (badge) {
                    if (badge.getAttribute('data-mac') !== mac) return;
                    badge.className = 'badge lease-state ' + getStateBadgeClass(newState);
                    badge.textContent = stateDisplayNames[newState] || newState;
                });
                toast('Lease state updated to ' + (stateDisplayNames[newState] || newState), true);
            } else {
                toast('Failed to update lease state: ' + (data.message || 'Unknown error'), false);
            }
        })
        .catch(function () { toast('Failed to update lease state', false); });
}

function showLeaseHistory(mac) {
    fetch('/dhcp/lease/history?mac=' + encodeURIComponent(mac))
        .then(function (response) { return response.json(); })
        .then(function (data) {
            var rows = (data.history && data.history.length)
                ? data.history.map(function (entry) {
                    return '<div class="flex justify-between items-center py-2 border-b"><div><span class="badge ' + getStateBadgeClass(entry.to_state) + '">' + entry.to_state + '</span> <span class="mu">' + (entry.source || '') + '</span></div><span class="mu">' + new Date(entry.timestamp).toLocaleString() + '</span></div>';
                }).join('')
                : '<p class="mu">No history available for this lease.</p>';
            document.body.insertAdjacentHTML('beforeend',
                '<div class="modal modal-open"><div class="modal-box"><h3 class="font-bold text-lg">Lease history for ' + mac + '</h3><div class="py-4">' + rows + '</div><div class="modal-action"><button class="btn" onclick="closeHistoryModal()">Close</button></div></div></div>');
        })
        .catch(function () { toast('Failed to load lease history', false); });
}

function closeHistoryModal() {
    var modal = document.querySelector('.modal.modal-open');
    if (modal) modal.remove();
}

function getStateBadgeClass(state) {
    var stateClasses = {
        'assigned': 'badge-info',
        'pxe_requested': 'badge-warning',
        'booting': 'badge-warning',
        'imaging': 'badge-accent',
        'imaged': 'badge-success',
        'configuring': 'badge-accent',
        'complete': 'badge-success',
        'failed': 'badge-error',
        'offline': 'badge-ghost'
    };
    return stateClasses[state] || 'badge-ghost';
}
</script>
{{end}}
