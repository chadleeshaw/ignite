<!DOCTYPE html>
<html lang="en" data-theme="ignite">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
</head>
<body class="bg-base-100">
<main>
    <p>{{.StatusCode}}</p>
    <h1>{{.Heading}}</h1>
    <p>{{.Message}}</p>
    <a href="/login">Sign in</a>
</main>
</body>
</html>
