<!DOCTYPE html>
<html lang="en" data-theme="{{or .Mode "cozy"}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/public/http/css/tailwind.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>
<body class="bg-base-100">
<main>
    <p>{{.StatusCode}}</p>
    <h1>{{.Heading}}</h1>
    <p>{{.Message}}</p>
    <a href="/login">Sign in</a>
</main>
</body>
</html>
