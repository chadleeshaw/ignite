{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">Provision</span><span class="only-console">provision</span></h1>
        <p class="sub only-cozy">Templates are reusable starting points; configs are rendered, ready-to-use files</p>
        <p class="sub only-console">templates · configs</p>
    </div>
    <div class="actions">
        <button class="b" type="button" onclick="toggleHelp()">Quick help</button>
        <button class="b p" type="button" hx-get="/open_modal?template=provision-new-file" hx-target="#modal-content">New file</button>
    </div>
</header>

<div class="prov-top">
    <article class="sv on">
        <div class="fire"><img src="/public/http/img/flame.svg" alt=""></div>
        <div>
            <small>Templates</small>
            <b class="mono">{{countPhrase .TemplateCount "file" "files"}}</b>
        </div>
        <span class="st in" style="margin-left:auto">Reusable</span>
    </article>
    <article class="sv">
        <div>
            <small>Configs</small>
            <b class="mono">{{countPhrase .ConfigCount "file" "files"}}</b>
        </div>
        <span class="st ok" style="margin-left:auto">Rendered</span>
    </article>
    <section class="stats strip" aria-label="Provision files">
        {{range .CategoryCounts}}
        <div class="stat">
            <div class="stat-title">{{.Name}}</div>
            <div class="stat-value">{{.Count}}</div>
        </div>
        {{end}}
        <div class="stat">
            <div class="stat-title">Last saved</div>
            <div class="stat-value">{{if .LastSaved.IsZero}}—{{else}}<time datetime="{{rfc3339 .LastSaved}}" data-time="time">{{utcLabel .LastSaved "15:04"}}</time>{{end}}</div>
        </div>
    </section>
</div>

<div role="main" class="main flip">
    <section class="panel" id="file-list">
        <div class="ph">
            <h3>Files</h3>
            <span class="mu">{{len .Files}}</span>
        </div>
        <div class="chips">
            <button type="button" class="chip on" data-filter="all" onclick="filterKind(this)">All {{len .Files}}</button>
            <button type="button" class="chip" data-filter="template" onclick="filterKind(this)">Templates</button>
            <button type="button" class="chip" data-filter="config" onclick="filterKind(this)">Configs</button>
        </div>
        <div class="fl" id="file-browser">
            {{if gt .TemplateCount 0}}
            <div class="sec" data-type="template">Templates</div>
            {{range .Files}}{{if eq .Type "template"}}
            <button type="button" class="f file-item"
                    data-type="{{.Type}}" data-category="{{.Category}}" data-name="{{.Name}}" data-path="{{.Path}}" data-language="{{.Language}}"
                    onclick="selectFile(this)">
                <span class="sq {{.Language}}"></span>
                <span class="nm mono">{{.Name}}</span>
                <small>{{.Category}}</small>
            </button>
            {{end}}{{end}}
            {{end}}
            {{if gt .ConfigCount 0}}
            <div class="sec" data-type="config">Configs</div>
            {{range .Files}}{{if eq .Type "config"}}
            <button type="button" class="f file-item"
                    data-type="{{.Type}}" data-category="{{.Category}}" data-name="{{.Name}}" data-path="{{.Path}}" data-language="{{.Language}}"
                    onclick="selectFile(this)">
                <span class="sq {{.Language}}"></span>
                <span class="nm mono">{{.Name}}</span>
                <small>{{.Category}}</small>
            </button>
            {{end}}{{end}}
            {{end}}
        </div>
        <div class="panel-foot">
            <button class="b sm" type="button" hx-get="/open_modal?template=provision-new-file" hx-target="#modal-content">+ New file</button>
        </div>
    </section>

    <section class="panel" id="editor-panel">
        <div class="ph editor-head">
            <h3 class="mono" id="current-filename">No file selected</h3>
            <span class="tag" id="type-tag" hidden></span>
            <span class="tag" id="category-tag" hidden></span>
            <span class="grow"></span>
            <span id="file-status" class="st wa" hidden>Unsaved changes</span>
            <button class="b sm" type="button" onclick="validateSyntax()">Validate</button>
            <button class="b sm" type="button" onclick="previewFile()">Preview</button>
            <button class="b sm p" type="button" id="save-btn" onclick="saveFile()" disabled>Save</button>
            <button class="b sm dg" type="button" id="delete-btn" onclick="deleteCurrent()" disabled>Delete…</button>
        </div>
        <div class="chips">
            <button type="button" class="chip" onclick="insertTemplate('cloud-init-user')">+ Add user</button>
            <button type="button" class="chip" onclick="insertTemplate('cloud-init-package')">+ Install packages</button>
            <button type="button" class="chip" onclick="insertTemplate('kickstart-partition')">+ Partition</button>
            <button type="button" class="chip" onclick="insertTemplate('network-config')">+ Network</button>
            <span class="mu" style="margin-left:auto;align-self:center">Snippets</span>
        </div>
        <div class="code-edit">
            <pre class="ln" id="editor-lines" aria-hidden="true">1</pre>
            <textarea id="editor-textarea" spellcheck="false" placeholder="Select a file to edit or create a new one..."
                      oninput="onEditorInput()" onkeyup="updateCursorPosition()" onclick="updateCursorPosition()"
                      onscroll="syncEditorScroll()"></textarea>
        </div>
        <div class="editor-foot">
            <span id="syntax-status" class="st ok" hidden>Checked</span>
            <span id="editor-info">0 lines · 0 chars</span>
            <span id="cursor-position" style="margin-left:auto">Ln 1, Col 1</span>
        </div>
    </section>
</div>

<section class="panel pad-in mt" id="help-panel" hidden>
    <div id="help-content" class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm">
        <div>
            <h4 class="font-semibold mb-2">Templates vs configs</h4>
            <ul class="space-y-1 mu">
                <li>Templates are reusable starting points</li>
                <li>Configs are rendered, ready-to-use files</li>
            </ul>
        </div>
        <div>
            <h4 class="font-semibold mb-2">Cloud-init</h4>
            <p class="mu">YAML for users, packages, and SSH keys.</p>
        </div>
        <div>
            <h4 class="font-semibold mb-2">Kickstart</h4>
            <p class="mu">Scripted installs, partitions, and packages.</p>
        </div>
        <div>
            <h4 class="font-semibold mb-2">Editing</h4>
            <p class="mu">Pick a file, edit, then Save. Preview uses the shared highlighter.</p>
        </div>
    </div>
</section>

<script>
var currentFile = null;
var isModified = false;

function toast(message, isSuccess) {
    if (typeof igniteToast === "function") igniteToast(message, isSuccess);
}

function loadFile(path, name, language, type, category) {
    currentFile = { path: path, name: name, language: language, type: type, category: category };
    document.getElementById("current-filename").textContent = name;
    var typeTag = document.getElementById("type-tag");
    var catTag = document.getElementById("category-tag");
    typeTag.hidden = false;
    typeTag.textContent = type === "config" ? "Config" : "Template";
    catTag.hidden = !category && !language;
    catTag.textContent = category || language || "";
    document.getElementById("save-btn").disabled = false;
    document.getElementById("delete-btn").disabled = false;
    fetch("/provision/load-file?path=" + encodeURIComponent(path))
        .then(function (response) { return response.text(); })
        .then(function (content) {
            document.getElementById("editor-textarea").value = content;
            isModified = false;
            updateFileStatus();
            updateEditorInfo();
            updateCursorPosition();
        })
        .catch(function () { toast("Could not load that file.", false); });
}

function selectFile(fileItem) {
    document.querySelectorAll(".file-item").forEach(function (el) { el.classList.remove("on"); });
    fileItem.classList.add("on");
    loadFile(
        fileItem.getAttribute("data-path"),
        fileItem.getAttribute("data-name"),
        fileItem.getAttribute("data-language"),
        fileItem.getAttribute("data-type"),
        fileItem.getAttribute("data-category")
    );
}

function deleteCurrent() {
    if (!currentFile) return;
    var row = document.querySelector('.file-item.on');
    deleteFile(currentFile.path, currentFile.name, row);
}

function deleteFile(filePath, fileName, row) {
    if (!confirm('Delete "' + fileName + '"? This cannot be undone.')) return;
    var formData = new FormData();
    formData.append("path", filePath);
    formData.append("csrf_token", typeof igniteCSRF === "function" ? igniteCSRF() : "");
    igniteFetch("/provision/delete-file", { method: "POST", body: formData })
        .then(function (response) {
            return response.text().then(function (text) {
                var data = {};
                try { data = JSON.parse(text); } catch (err) {}
                return { response: response, data: data, text: text };
            });
        })
        .then(function (result) {
            if (result.response.ok && result.data.success) {
                toast("File deleted.", true);
                if (currentFile && currentFile.path === filePath) clearEditor();
                if (row && row.remove) row.remove();
                return;
            }
            toast(igniteResponseMessage({ responseText: result.text }, "Could not delete that file."), false);
        })
        .catch(function () { toast("Could not delete that file.", false); });
}

function saveFile() {
    if (!currentFile) {
        toast("No file selected", false);
        return;
    }
    var content = document.getElementById("editor-textarea").value;
    var formData = new FormData();
    formData.append("path", currentFile.path);
    formData.append("content", content);
    formData.append("csrf_token", typeof igniteCSRF === "function" ? igniteCSRF() : "");
    igniteFetch("/provision/save-file", { method: "POST", body: formData })
        .then(function (response) {
            return response.text().then(function (text) {
                var data = {};
                try { data = JSON.parse(text); } catch (err) {}
                if (response.ok && data.success) {
                    isModified = false;
                    updateFileStatus();
                    toast("File saved.", true);
                    return;
                }
                toast(igniteResponseMessage({ responseText: text }, "Could not save that file."), false);
            });
        })
        .catch(function () { toast("Could not save that file.", false); });
}

function clearEditor() {
    document.getElementById("editor-textarea").value = "";
    currentFile = null;
    isModified = false;
    document.getElementById("current-filename").textContent = "No file selected";
    document.getElementById("type-tag").hidden = true;
    document.getElementById("category-tag").hidden = true;
    document.getElementById("save-btn").disabled = true;
    document.getElementById("delete-btn").disabled = true;
    document.querySelectorAll(".file-item").forEach(function (el) { el.classList.remove("on"); });
    updateFileStatus();
    updateEditorInfo();
}

function onEditorInput() {
    isModified = true;
    updateFileStatus();
    updateEditorInfo();
    updateCursorPosition();
}

function updateCursorPosition() {
    var textarea = document.getElementById("editor-textarea");
    var lines = textarea.value.substr(0, textarea.selectionStart).split("\n");
    document.getElementById("cursor-position").textContent = "Ln " + lines.length + ", Col " + (lines[lines.length - 1].length + 1);
}

function syncEditorScroll() {
    var area = document.getElementById("editor-textarea");
    var gutter = document.getElementById("editor-lines");
    gutter.scrollTop = area.scrollTop;
}

function previewFile() {
    if (!currentFile) {
        toast("No file selected", false);
        return;
    }
    var content = document.getElementById("editor-textarea").value;
    var filename = currentFile.name || "Untitled";
    var language = currentFile.language || "text";
    var host = document.getElementById("modal-content");
    host.replaceChildren();
    var modal = document.createElement("div");
    modal.id = "preview-modal";
    modal.className = "modal modal-open";
    var box = document.createElement("div");
    box.className = "modal-box max-w-4xl";
    var head = document.createElement("div");
    head.className = "flex justify-between items-center mb-4";
    var title = document.createElement("h3");
    title.className = "font-bold text-lg";
    title.textContent = "Preview: " + filename;
    var badge = document.createElement("span");
    badge.className = "badge badge-outline";
    badge.textContent = language;
    head.append(title, badge);
    var frame = document.createElement("div");
    frame.className = "bg-base-300 p-4 rounded-lg";
    var pre = document.createElement("pre");
    pre.id = "preview-content";
    pre.className = "hl text-sm overflow-x-auto max-h-96 whitespace-pre-wrap";
    var shown = language;
    if (typeof igniteHighlightLanguage === "function" && (!shown || shown === "text")) {
        shown = igniteHighlightLanguage(filename, content);
    }
    badge.textContent = shown;
    if (typeof igniteHighlight === "function") {
        igniteHighlight(pre, content, shown);
    } else {
        pre.textContent = content;
    }
    frame.appendChild(pre);
    var actions = document.createElement("div");
    actions.className = "modal-action";
    var close = document.createElement("button");
    close.type = "button";
    close.className = "btn";
    close.textContent = "Close";
    close.addEventListener("click", closePreviewModal);
    actions.appendChild(close);
    box.append(head, frame, actions);
    modal.appendChild(box);
    host.appendChild(modal);
}

function closePreviewModal() {
    var host = document.getElementById("modal-content");
    if (host) host.replaceChildren();
}

function updateFileStatus() {
    var statusEl = document.getElementById("file-status");
    if (statusEl) statusEl.hidden = !isModified;
}

function updateEditorInfo() {
    var textarea = document.getElementById("editor-textarea");
    var count = textarea.value.length ? textarea.value.split("\n").length : 0;
    var chars = textarea.value.length;
    document.getElementById("editor-info").textContent = count + " lines · " + chars + " chars";
    var lines = [];
    var n = Math.max(count, 1);
    for (var i = 1; i <= n; i++) lines.push(String(i));
    document.getElementById("editor-lines").textContent = lines.join("\n");
}

function validateSyntax() {
    var text = document.getElementById("editor-textarea").value;
    var status = document.getElementById("syntax-status");
    status.hidden = false;
    if (!text.trim()) {
        status.className = "st wa";
        status.textContent = "Empty file";
        return;
    }
    status.className = "st ok";
    status.textContent = "Checked";
}

function toggleHelp() {
    var panel = document.getElementById("help-panel");
    panel.hidden = !panel.hidden;
}

function filterKind(btn) {
    document.querySelectorAll(".chips .chip[data-filter]").forEach(function (chip) {
        chip.classList.toggle("on", chip === btn);
    });
    var kind = btn.getAttribute("data-filter");
    document.querySelectorAll(".file-item").forEach(function (item) {
        item.hidden = kind !== "all" && item.getAttribute("data-type") !== kind;
    });
    document.querySelectorAll(".sec[data-type]").forEach(function (sec) {
        sec.hidden = kind !== "all" && sec.getAttribute("data-type") !== kind;
    });
}

function insertTemplate(templateType) {
    var templates = {
        "cloud-init-user": "users:\n  - name: admin\n    groups: [adm, sudo]\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    ssh_authorized_keys:\n      - ssh-rsa AAAAB3N... your-key-here",
        "cloud-init-package": "packages:\n  - nginx\n  - git\n  - curl\n  - vim\n\npackage_update: true\npackage_upgrade: true",
        "kickstart-partition": "clearpart --all --initlabel\npart /boot --fstype=ext4 --size=512\npart pv.01 --size=1 --grow\nvolgroup vg_root pv.01\nlogvol / --fstype=ext4 --name=lv_root --vgname=vg_root --size=8192",
        "network-config": "network:\n  version: 2\n  ethernets:\n    eth0:\n      dhcp4: true\n      dhcp6: false"
    };
    var snippet = templates[templateType];
    if (!snippet) return;
    var textarea = document.getElementById("editor-textarea");
    var start = textarea.selectionStart;
    var end = textarea.selectionEnd;
    var text = textarea.value;
    textarea.value = text.substring(0, start) + snippet + text.substring(end);
    textarea.focus();
    textarea.selectionStart = textarea.selectionEnd = start + snippet.length;
    isModified = true;
    updateFileStatus();
    updateEditorInfo();
    updateCursorPosition();
}

function createNewFile(filePath, filename, language, content) {
    currentFile = { path: filePath, name: filename, language: language, type: "template", category: language };
    document.getElementById("current-filename").textContent = filename;
    document.getElementById("type-tag").hidden = false;
    document.getElementById("type-tag").textContent = "Template";
    document.getElementById("category-tag").hidden = false;
    document.getElementById("category-tag").textContent = language || "";
    document.getElementById("save-btn").disabled = false;
    document.getElementById("delete-btn").disabled = false;
    document.getElementById("editor-textarea").value = content;
    isModified = content.length > 0;
    updateFileStatus();
    updateEditorInfo();
}

window.addEventListener("message", function (event) {
    if (event.data && event.data.type === "createNewFile") {
        var file = event.data.file;
        createNewFile(file.path, file.name, file.language, file.content);
    }
});

document.addEventListener("DOMContentLoaded", function () {
    updateEditorInfo();
    var first = document.querySelector(".file-item");
    if (first) selectFile(first);
});

document.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === "s" || e.key === "S")) {
        var tag = (e.target && e.target.tagName || "").toLowerCase();
        if (tag === "textarea" || tag === "input" || (e.target && e.target.isContentEditable)) {
            e.preventDefault();
            saveFile();
        }
    }
});
</script>
{{ end }}
