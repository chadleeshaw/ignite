{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">Syslinux</span><span class="only-console">syslinux</span></h1>
        {{ $active := "" }}
        {{range .Versions}}{{if .Active}}{{ $active = .Version }}{{end}}{{end}}
        <p class="sub only-cozy">{{if $active}}Version {{$active}} is active for BIOS and EFI{{else}}No active version. One install covers BIOS and EFI.{{end}}</p>
        <p class="sub only-console">{{if $active}}active {{$active}} · bios+efi{{else}}no active version{{end}}</p>
    </div>
    <div class="actions">
        <button class="b p" type="button" onclick="document.getElementById('scanModal').showModal()">Scan mirror</button>
    </div>
</header>

<div id="syslinux-downloads">
<div id="active-downloads" class="mt"{{if .Downloads}} hx-get="/syslinux" hx-select="#syslinux-downloads" hx-target="#syslinux-downloads" hx-trigger="every 5s"{{end}}>
{{if .Downloads}}
<section class="panel">
    <div class="pad"><b>Active downloads</b></div>
    <div class="scroll">
        <table>
            <thead><tr><th>Version</th><th>Status</th><th>Progress</th><th>Started</th><th></th></tr></thead>
            <tbody>
                {{range .Downloads}}
                <tr>
                    <td class="mono">{{.Version}}</td>
                    <td><span class="st in">{{.Status}}</span></td>
                    <td><span class="prog"><i style="width: {{.Progress}}%"></i></span> {{.Progress}}%</td>
                    <td>{{.StartedAt.Format "15:04:05"}}</td>
                    <td>
                        {{if or (eq .Status "downloading") (eq .Status "queued")}}
                        <button class="b dg sm" hx-post="/api/syslinux/downloads/{{.ID}}/cancel" hx-confirm="Cancel this download?">Cancel</button>
                        {{end}}
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
</section>
{{end}}
</div>
</div>

<section class="panel mt">
    {{if .Versions}}
    <div class="scroll">
        <table>
            <thead>
                <tr><th>Version</th><th>Status</th><th>Size</th><th>Downloaded</th><th></th></tr>
            </thead>
            <tbody>
                {{range .Versions}}
                <tr>
                    <td class="mono">{{.Version}}</td>
                    <td>
                        {{if .Active}}
                        <span class="st ok">active</span>
                        {{else if .Downloaded}}
                        <span class="st wa">downloaded</span>
                        {{else}}
                        <span class="st of">available</span>
                        {{end}}
                    </td>
                    <td>{{formatBytes .Size}}</td>
                    <td>{{if .DownloadedAt}}{{.DownloadedAt.Format "2006-01-02 15:04"}}{{else}}—{{end}}</td>
                    <td>
                        <div class="actions">
                            {{if not .Downloaded}}
                            <button class="b p sm"
                                    hx-post="/api/syslinux/download/{{.Version}}"
                                    hx-swap="none"
                                    hx-confirm="Download Syslinux {{.Version}}? The download also becomes the active BIOS and EFI install.">Download</button>
                            {{end}}
                            {{if .Active}}
                            <button class="b sm" type="button" onclick="showVersionInfo('{{.Version}}')">Info</button>
                            <button class="b dg sm"
                                    hx-post="/api/syslinux/deactivate/{{.Version}}"
                                    hx-swap="none"
                                    hx-confirm="Deactivate Syslinux {{.Version}} and remove its boot files?">Deactivate</button>
                            {{end}}
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
    <p class="note">One active version supplies both BIOS and EFI boot files. This page does not list the files inside a version.</p>
    {{else}}
    <div class="note">
        <p>No Syslinux versions yet. Scan the mirror to list what can be installed.</p>
        <button class="b p sm mt" type="button" onclick="document.getElementById('scanModal').showModal()">Scan mirror</button>
    </div>
    {{end}}
</section>

<dialog id="scanModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Scan mirror</h3>
        <p class="mb-4">Looks at https://mirrors.kernel.org/pub/linux/utils/boot/syslinux/ for versions.</p>
        <div class="modal-action">
            <button type="button" class="btn" onclick="document.getElementById('scanModal').close()">Cancel</button>
            <button type="button" class="btn btn-primary"
                    hx-post="/api/syslinux/scan"
                    hx-swap="none"
                    hx-on::after-request="if (event.detail.successful) window.location.href='/syslinux'">Start scan</button>
        </div>
    </div>
</dialog>

<dialog id="infoModal" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Syslinux version</h3>
        <div id="versionInfo"></div>
        <div class="modal-action">
            <button type="button" class="btn" onclick="document.getElementById('infoModal').close()">Close</button>
        </div>
    </div>
</dialog>

<script>
function showVersionInfo(version) {
    fetch('/api/syslinux/versions/' + encodeURIComponent(version))
        .then(function (response) { return response.json(); })
        .then(function (data) {
            fillFacts(document.getElementById('versionInfo'), [
                ['Version', data.version, ''],
                ['File', data.file_name, 'mono'],
                ['Size', formatBytes(data.size), ''],
                ['URL', data.download_url, 'mono'],
                ['Covers', 'BIOS and EFI', '']
            ]);
            document.getElementById('infoModal').showModal();
        })
        .catch(function () { alert('Failed to load version information'); });
}

function fillFacts(el, rows) {
    el.replaceChildren();
    var grid = document.createElement('div');
    grid.className = 'kv';
    rows.forEach(function (row) {
        var label = document.createElement('span');
        label.textContent = row[0];
        var value = document.createElement('span');
        if (row[2]) value.className = row[2];
        value.textContent = row[1] == null ? '' : String(row[1]);
        grid.appendChild(label);
        grid.appendChild(value);
    });
    el.appendChild(grid);
}

function formatBytes(bytes) {
    if (!bytes) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}
</script>
{{ end }}
