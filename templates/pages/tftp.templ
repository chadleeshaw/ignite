{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">TFTP</span><span class="only-console">tftp</span></h1>
        <p class="sub only-cozy">{{countPhrase .FileCount "file" "files"}} · {{countPhrase .DirCount "folder" "folders"}} · server {{.ServerStatus}}</p>
        <p class="sub only-console">{{countPhrase .FileCount "file" "files"}} · {{countPhrase .DirCount "dir" "dirs"}} · server {{.ServerStatus}}</p>
        <nav class="crumbs" aria-label="TFTP directory">
            <a href="/tftp">{{if .Root}}{{.Root}}{{else}}root{{end}}</a>
            {{range .Breadcrumbs}}
            <span>/</span>
            <a href="/tftp/open?dir={{.Dir}}">{{.Name}}</a>
            {{end}}
        </nav>
    </div>
    <div class="actions">
        <span class="st {{if eq .ServerStatus "running"}}ok{{else if eq .ServerStatus "unknown"}}wa{{else}}er{{end}}">{{.ServerStatus}}</span>
        <button class="b p" type="button" onclick="document.getElementById('uploadModal').showModal()">Upload</button>
    </div>
</header>

<section class="panel mt">
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Modified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{if .PrevDirectory}}
                <tr>
                    <td colspan="3"><a href="{{if eq .PrevDirectory ""}}/tftp{{else}}/tftp/open?dir={{.PrevDirectory}}{{end}}">..</a></td>
                    <td></td>
                </tr>
                {{else if .ServerDirectory}}
                <tr>
                    <td colspan="3"><a href="/tftp">..</a></td>
                    <td></td>
                </tr>
                {{end}}
                {{range .Files}}
                <tr>
                    <td class="mono">{{.Name}}</td>
                    <td>{{if .IsDir}}—{{else}}{{.Size}}{{end}}</td>
                    <td>{{.LastModified}}</td>
                    <td>
                        <div class="actions">
                            {{if .IsDir}}
                            <button class="b sm" type="button" onclick="window.location.href='/tftp/open?dir={{.Name}}'">Open</button>
                            {{else}}
                            <button class="b sm downloadBtn" type="button" onclick="window.location.href='/tftp/download?file={{.Name}}'">Download</button>
                            <button class="b sm viewBtn" hx-get="/open_modal?template=viewmodal&file={{.Name}}" hx-target="#modal-content">View</button>
                            {{end}}
                            <button class="b dg sm deleteBtn" hx-post="/tftp/delete_file?file={{.Name}}" hx-swap="none" hx-on::after-request="if (event.detail.successful) location.reload();">Delete</button>
                        </div>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="4">This directory is empty.</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>
</section>

{{ template "uploadmodal" }}
{{ end }}
