{{ define "content" }}
<header class="pagehead">
    <div>
        <h1><span class="only-cozy">TFTP</span><span class="only-console">tftp</span></h1>
        <p class="sub only-cozy">{{countPhrase .FileCount "file" "files"}} · {{countPhrase .DirCount "folder" "folders"}} · server {{.ServerStatus}}</p>
        <p class="sub only-console">{{countPhrase .FileCount "file" "files"}} · {{countPhrase .DirCount "folder" "folders"}} · server {{.ServerStatus}}</p>
        <nav class="crumbs" aria-label="TFTP directory">
            {{if .ServerDirectory}}
            <a href="{{if .PrevDirectory}}/tftp/open?dir={{.PrevDirectory}}{{else}}/tftp{{end}}">Up</a>
            <span aria-hidden="true">/</span>
            {{end}}
            <a href="/tftp"><span class="only-cozy">tftp root</span><span class="only-console">/</span></a>
            {{range .Breadcrumbs}}
            <span>/</span>
            <a href="/tftp/open?dir={{.Dir}}">{{.Name}}</a>
            {{end}}
        </nav>
    </div>
    <div class="actions">
        <span class="st {{if eq .ServerStatus "running"}}ok{{else if eq .ServerStatus "unknown"}}wa{{else}}er{{end}}">{{.ServerStatus}}</span>
        <button class="b p" type="button" onclick="document.getElementById('uploadModal').showModal()">Upload</button>
    </div>
</header>

<section class="panel mt">
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Modified</th>
                    <th class="acts">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Files}}
                <tr>
                    <td class="mono">
                        {{if .IsDir}}
                        <a class="file-link" href="/tftp/open?dir={{.Name}}"><i class="fas fa-folder" aria-hidden="true"></i> {{if .Base}}{{.Base}}{{else}}{{.Name}}{{end}}/</a>
                        {{else}}
                        {{if .Base}}{{.Base}}{{else}}{{.Name}}{{end}}
                        {{end}}
                    </td>
                    <td>{{if .IsDir}}—{{else}}{{.Size}}{{end}}</td>
                    <td>{{if .ModTime.IsZero}}—{{else}}<time datetime="{{rfc3339 .ModTime}}" data-time="datetime">{{utcLabel .ModTime "2006-01-02 15:04:05"}}</time>{{end}}</td>
                    <td class="acts">
                        <div class="actions stable slots">
                            {{if .IsDir}}
                            <a class="b sm" href="/tftp/open?dir={{.Name}}"><span class="label-fit"><span>Open</span><span aria-hidden="true">Download</span></span></a>
                            <button class="b sm" type="button" disabled tabindex="-1"><span class="label-fit"><span>—</span><span aria-hidden="true">View</span></span></button>
                            {{else}}
                            <button class="b sm downloadBtn" type="button" onclick="window.location.href='/tftp/download?file={{.Name}}'"><span class="label-fit"><span>Download</span><span aria-hidden="true">Open</span></span></button>
                            <button class="b sm viewBtn" hx-get="/open_modal?template=viewmodal&file={{.Name}}" hx-target="#modal-content"><span class="label-fit"><span>View</span><span aria-hidden="true">—</span></span></button>
                            {{end}}
                            <button class="b dg sm deleteBtn" hx-post="/tftp/delete_file?file={{.Name}}" hx-swap="none" hx-on::after-request="if (event.detail.successful) location.reload();">Delete</button>
                        </div>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="4">This directory is empty.</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>
</section>

{{ template "uploadmodal" }}
{{ end }}
