#version=RHEL8
# Use text mode install
text

# Keyboard layouts
keyboard --vckeymap=us --xlayouts='us'

# System language
lang en_US.UTF-8

# Network information
network  --bootproto=static --device=eth0 --gateway={{ .gateway }} --ip={{ .ip }} --netmask={{ .subnet }} --ipv6=disable --activate
network  --hostname={{ .hostname }}

# Set up the root password
rootpw --iscrypted $1$some-salted-hash

# System timezone
timezone America/Denver --isUtc

# Disk partitioning information
clearpart --all --initlabel
autopart --type=lvm
part /boot --fstype="xfs" --size=500
part / --fstype="xfs" --size=10000 --grow
part /var --fstype="xfs" --size=10000

# Package installation
%packages --ignoremissing
@core
sudo
openssh-server
fail2ban
firewalld
htop
logrotate
rsyslog
vim-enhanced
git
curl
nmap
%end

# Callbacks are best-effort. A missing curl or an unreachable server must not stop the install.
%pre --log=/tmp/ks-pre.log
curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" -d "state=imaging" -d "source=kickstart" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/state" || true
curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/heartbeat" || true
%end

# Post installation script
%post --log=/root/ks-post.log
ignite_state() {
  curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" -d "state=$1" -d "source=kickstart" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/state" || true
}
ignite_heartbeat() {
  curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/heartbeat" || true
}
ignite_state configuring
ignite_heartbeat
fail=0
# Update system
dnf update -y || fail=1
dnf upgrade -y || fail=1

# Install additional packages if not included in the package group
dnf install -y apt-transport-https || fail=1

# Remove unnecessary packages
dnf remove -y cups samba || fail=1

# Clean up
dnf clean all || fail=1

# Enable and start services
systemctl enable sshd || fail=1
systemctl start sshd || fail=1

systemctl enable firewalld || fail=1
systemctl start firewalld || fail=1

# Set up basic firewall rules if needed
firewall-cmd --permanent --add-service=ssh || fail=1
firewall-cmd --reload || fail=1

if [ "$fail" -eq 0 ]; then
  ignite_state complete
else
  ignite_state failed
fi
ignite_heartbeat
echo "Installation complete, rebooting..."
reboot
%end

%onerror --log=/tmp/ks-error.log
curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" -d "state=failed" -d "source=kickstart" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/state" || true
curl -fsS -m 10 -X POST -H "Authorization: Bearer {{ .provision_token }}" "http://{{ .tftpip }}/dhcp/lease/{{ .mac }}/heartbeat" || true
%end

# Additional configuration (if any)
%addon com_redhat_kdump --enable --reserve-mb='auto'
%end