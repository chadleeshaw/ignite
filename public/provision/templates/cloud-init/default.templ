#cloud-config

hostname: {{ .hostname }}

# Configure network
write_files:
  - content: |
      network:
        version: 2
        ethernets:
          eth0:
            dhcp4: false
            dhcp6: false
            accept-ra: false
            link-local: []
            addresses:
              - {{ .ip }}/{{ .subnet }}
            gateway4: {{ .gateway }}
            nameservers:
              addresses:
                - {{ .dns }}
    path: /etc/netplan/50-eth0.yaml
    owner: root:root
    permissions: '0644'

# Packages to install
packages:
  - sudo
  - openssh-server
  - fail2ban
  - ufw
  - htop
  - logrotate
  - rsyslog
  - vim
  - git
  - curl
  - nmap

# Run commands to apply network changes and partition the disk.
# Callbacks are best-effort: a missing server or a failed curl must not stop the install.
runcmd:
  - |
    #!/bin/sh
    ignite_state() {
      curl -fsS -m 10 -X POST -H {{ shellQuote (printf "Authorization: Bearer %s" .provision_token) }} -d "state=$1" -d "source=cloud-init" {{ shellQuote (printf "http://%s/dhcp/lease/%s/state" .tftpip .mac) }} || true
    }
    ignite_heartbeat() {
      curl -fsS -m 10 -X POST -H {{ shellQuote (printf "Authorization: Bearer %s" .provision_token) }} {{ shellQuote (printf "http://%s/dhcp/lease/%s/heartbeat" .tftpip .mac) }} || true
    }
    ignite_state configuring
    ignite_heartbeat
    fail=0
    netplan apply || fail=1
    parted /dev/sda --script mklabel gpt || fail=1
    parted /dev/sda --script mkpart primary ext4 500MiB 2GiB || fail=1
    parted /dev/sda --script mkpart primary ext4 10Gib 20GiB || fail=1
    parted /dev/sda --script mkpart primary ext4 20GiB 100% || fail=1
    mkfs.ext4 -L boot /dev/sda1 || fail=1
    mkfs.ext4 -L var /dev/sda2 || fail=1
    mkfs.ext4 -L root /dev/sda3 || fail=1
    mkdir -p /mnt/boot /mnt/var /mnt/root || fail=1
    mount /dev/sda1 /mnt/boot || fail=1
    mount /dev/sda2 /mnt/var || fail=1
    mount /dev/sda3 /mnt/root || fail=1
    echo "/dev/sda1  /boot  ext4    defaults        0       1" >> /etc/fstab || fail=1
    echo "/dev/sda2  /var   ext4    defaults        0       2" >> /etc/fstab || fail=1
    echo "/dev/sda3  /      ext4    defaults        0       2" >> /etc/fstab || fail=1
    mount -a || fail=1
    cloud-init status --wait || fail=1
    if [ "$fail" -eq 0 ]; then
      ignite_state complete
    else
      ignite_state failed
    fi
    ignite_heartbeat
    shutdown -r now || true